# ------------------------- GENERAL SETTINGS -------------------------
#adjust to spam level desired (options: error, warn, info, debug)
RUST_LOG=debug
ENABLE_PARSING=true
ENABLE_PG_WRITES=true
ENABLE_CLICKHOUSE_WRITES=true
IPFS_URL=
RPC_URL=

# ------------------------- AMQP PARAMS (AMQPParams struct) -------------------------
RABBITMQ_URL=amqps://<USER>:<PASSWORD>@<RABBIT_URL>:5671
RABBITMQ_QUEUE_PREFIX=ingestooor
RABBITMQ_EXCHANGE=mainnet.confirmed.messages
DEBUG_EXCHANGE=false
DEBUG_USER=YOUR_NAME_HERE
RABBITMQ_PREFETCH=1
# Explicitly set to false to keep queues after shutdown.
# if not set, queues will be deleted if DEBUG_USER is set
# AUTO_DELETE_QUEUES=false

# ------------------------- CLICKHOUSE PARAMS (ClickhouseParams struct) -------------------------
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=
CLICKHOUSE_PERIOD_BIAS_BPS=500
CLICKHOUSE_MAX_FLUSH_MS=25000
